# ── 로그인 자격증명 (선택) ─────────────────────────────────────
NAVER_ID=
NAVER_PW=
KAKAO_ID=
KAKAO_PW=
RIDIBOOKS_ID=
RIDIBOOKS_PW=

# ── MySQL (SSM 포트포워딩 기준) ────────────────────────────────
MYSQL_DATABASE_HOST=127.0.0.1
MYSQL_DATABASE_PORT=13306
MYSQL_DATABASE_USER=your_db_user
MYSQL_DATABASE_PASSWORD=your_db_password
MYSQL_DATABASE_NAME=your_db_name

# ── 스케줄러 (선택) ────────────────────────────────────────────
SCHED_TIMEZONE=Asia/Seoul
SCHED_INITIAL_NAVER_HOUR=3
SCHED_INITIAL_KAKAO_HOUR=6
SCHED_INITIAL_RIDIBOOKS_HOUR=9
SCHED_NEW_WORKS_HOUR=9
SCHED_UPDATE_FIELDS_WEEKDAY=mon
SCHED_UPDATE_FIELDS_HOUR=2

# ── 검수 파이프라인 (review/, cli.py stage) ─────────────────────
# BE 대상 환경 dev | prod (기본 dev). cli.py stage ... --env prod 로도 고를 수 있다
STORIX_ENV=dev
# BE 내부 API 키 (X-Internal-Api-Key). Parameter Store /storix/{dev,prod}/env/INTERNAL_API_KEY
STORIX_DEV_INTERNAL_API_KEY=
STORIX_PROD_INTERNAL_API_KEY=
# BE 주소를 바꿀 때만 (기본 dev https://dev.storix.kr, prod https://api.storix.kr)
# STORIX_DEV_API_BASE_URL=
# STORIX_PROD_API_BASE_URL=
# staging 테이블은 서비스 DB 와 분리된 DB 에 둔다 (같은 MySQL 인스턴스)
# 기본 storix_staging_{env}. import 상태가 환경마다 달라 dev / prod 를 나눈다
# STAGING_DATABASE_NAME=
# BE 를 못 붙을 때 카탈로그 응답을 저장한 JSON (선택)
REVIEW_CATALOG_FILE=
# 설정하면 검수 API 호출에 X-Review-Token 헤더 필요 (선택)
REVIEW_API_TOKEN=
