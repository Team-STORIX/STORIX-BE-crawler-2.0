# ── 로그인 자격증명 (선택) ─────────────────────────────────────
NAVER_ID=
NAVER_PW=
KAKAO_ID=
KAKAO_PW=
RIDIBOOKS_ID=
RIDIBOOKS_PW=

# ── MySQL (SSM 포트포워딩 기준) ────────────────────────────────
MYSQL_DATABASE_HOST=127.0.0.1
MYSQL_DATABASE_PORT=13306
MYSQL_DATABASE_USER=your_db_user
MYSQL_DATABASE_PASSWORD=your_db_password
MYSQL_DATABASE_NAME=your_db_name

# ── 스케줄러 (선택) ────────────────────────────────────────────
SCHED_TIMEZONE=Asia/Seoul
SCHED_INITIAL_NAVER_HOUR=3
SCHED_INITIAL_KAKAO_HOUR=6
SCHED_INITIAL_RIDIBOOKS_HOUR=9
SCHED_NEW_WORKS_HOUR=9
SCHED_UPDATE_FIELDS_WEEKDAY=mon
SCHED_UPDATE_FIELDS_HOUR=2

# ── 검수 파이프라인 (review/, cli.py stage) ─────────────────────
# staging 테이블은 서비스 DB 와 분리된 DB 에 둔다 (같은 MySQL 인스턴스)
STAGING_DATABASE_NAME=storix_staging
# BE enum 카탈로그 · 작품 import API
STORIX_API_BASE_URL=
STORIX_ADMIN_TOKEN=
# BE 를 못 붙을 때 카탈로그 응답을 저장한 JSON (선택)
REVIEW_CATALOG_FILE=
# 설정하면 검수 API 호출에 X-Review-Token 헤더 필요 (선택)
REVIEW_API_TOKEN=
